rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function admin(){return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';} match /projects/{id}{allow read: if resource.data.status == 'published' || admin(); allow create,update,delete: if admin();} match /contactMessages/{id}{allow create: if request.resource.data.keys().hasAll(['name','email','subject','message']) && request.resource.data.name.size() <= 100 && request.resource.data.message.size() <= 5000;allow read,update,delete: if admin();} match /users/{id}{allow read: if request.auth.uid == id || admin();allow write: if admin();} } }
